   "path": "/",
   "body": {
    "action": "login",
    "login": "nobody_here_x",
    "password": "wrongpass"
   },
   "expectedStatus": 401
  },
  {
   "name": "Сброс с неверным кодом",
   "method": "POST",
   "path": "/",
   "body": {
    "action": "reset",
    "login": "nobody_here_x",
    "code": "AAAA-BBBB-CCCC",
    "password": "newpass1"
   },
   "expectedStatus": 401
  }
 ]
}